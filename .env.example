# Environment mode (development / production)
ENV=development

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256

# Database
# For SQLite (local dev):
DATABASE_URL=sqlite:///./marketplace_v3.db
# For PostgreSQL (Docker / Prod):
# DATABASE_URL=postgresql+psycopg2://marketplace:marketplace_secret@localhost:5432/marketplace_db

# PostgreSQL credentials for docker-compose
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_secret
POSTGRES_DB=marketplace_db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Geocoding & Maps
# Optional: Nominatim User-Agent
GEOCODING_USER_AGENT=MarketplaceApp/1.0

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
